@using MyFinance.Shared.DTOs
@using MyFinance.Shared.Enums
@using MyFinance.Web.Services
@inject HttpClient Http
@inject FinanceStateService FinanceState
@inject PageStateService PageState
@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider

<MudMenu AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" Dense="true">
    <ActivatorContent>
        <MudButton Variant="Variant.Text"
                   Color="Color.Inherit"
                   Class="seletor-conta-btn"
                   StartIcon="@Icons.Material.Filled.AccountBalanceWallet"
                   EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                   Style="text-transform: none; font-weight: 500; width: 100%; justify-content: flex-start; padding-left: 16px;">
            @(FinanceState.SelectedAccountName ?? "Todas as Contas")
        </MudButton>
    </ActivatorContent>
    <ChildContent>
        <MudMenuItem OnClick="@(() => OnAccountSelected(null))">
            <div class="d-flex align-center">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                         Size="Size.Small"
                         Class="mr-2"
                         Color="@(FinanceState.SelectedAccountId == Guid.Empty ? Color.Success : Color.Transparent)" />
                <MudText Typo="Typo.body2" Style="font-weight: 600;">Todas as Contas</MudText>
            </div>
        </MudMenuItem>

        <MudDivider Class="my-1" />

        @if (_contas != null)
        {
            @foreach (var conta in _contas)
            {
                <MudMenuItem OnClick="@(() => OnAccountSelected(conta.Id))">
                    <div class="d-flex align-center w-100">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                                 Size="Size.Small"
                                 Class="mr-2"
                                 Color="@(FinanceState.SelectedAccountId == conta.Id ? Color.Success : Color.Transparent)" />

                        <MudText Typo="Typo.body2" Class="flex-grow-1 mr-4">@conta.Nome</MudText>

                        @if (conta.Tipo == TipoConta.Simulacao)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Science" Size="Size.Small" Color="Color.Info" Style="opacity: 0.9;" title="Simulação" />
                        }
                        else if (conta.Tipo == TipoConta.Corrente)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Size="Size.Small" Color="Color.Default" Style="opacity: 0.5;" title="Conta Corrente" />
                        }
                        else if (conta.Tipo == TipoConta.Poupanca)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Savings" Size="Size.Small" Color="Color.Default" Style="opacity: 0.5;" title="Poupança" />
                        }
                        else if (conta.Tipo == TipoConta.Investimento)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Small" Color="Color.Default" Style="opacity: 0.5;" title="Investimentos" />
                        }
                        else if (conta.Tipo == TipoConta.CartaoCredito)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.CreditCard" Size="Size.Small" Color="Color.Default" Style="opacity: 0.5;" title="Cartão de Crédito" />
                        }
                    </div>
                </MudMenuItem>
            }
        }
    </ChildContent>
</MudMenu>

@code {
    private List<ContaDto>? _contas;

    protected override async Task OnInitializedAsync()
    {
        await CarregarContas();
        PageState.OnCreateNewContaChanged += HandleContasChanged;
    }

    private async void HandleContasChanged()
    {
        await InvokeAsync(async () =>
        {
            await CarregarContas();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        PageState.OnCreateNewContaChanged -= HandleContasChanged;
    }

    private async Task CarregarContas()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity == null || !user.Identity.IsAuthenticated) return;

            var todasContas = await Http.GetFromJsonAsync<List<ContaDto>>("api/contas");

            if (todasContas != null)
            {
                _contas = todasContas.Where(c => c.Ativo).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar contas: {ex.Message}");
        }
    }

    private void OnAccountSelected(Guid? id)
    {
        var idFinal = id ?? Guid.Empty;
        var nome = _contas?.FirstOrDefault(c => c.Id == id)?.Nome ?? "Todas as Contas";

        FinanceState.SetAccount(idFinal, nome);
        StateHasChanged();
    }
}